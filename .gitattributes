# 全仓库统一 LF 换行（Windows / Linux 混合开发，避免整文件 diff）
* text=auto eol=lf

# 明确按文本处理
*.md      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.csv     text eol=lf
*.txt     text eol=lf
*.urdf    text eol=lf
*.xacro   text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# 二进制：不做换行转换、不做 diff
